# LINE Messaging API
# LINE Developersコンソールから取得
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# MQTT Broker
# 使用するMQTT Brokerのホスト名（例: broker.hivemq.com）
MQTT_BROKER_URL=your_mqtt_broker_hostname
MQTT_TOPIC=spresense/mqtt_sub

# Supabase
# Settings > API Keysから取得
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here
